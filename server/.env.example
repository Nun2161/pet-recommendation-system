PORT=3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=pet_project

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Path to a Firebase Admin service-account JSON file outside the public client folder.
GOOGLE_APPLICATION_CREDENTIALS=./secrets/firebase-service-account.json
FIREBASE_WEB_API_KEY=replace-with-firebase-web-api-key

SMTP_USER=Example@gmail.com
SMTP_APP_PASSWORD=replace-with-app-password
PASSWORD_RESET_PAGE_URL=http://127.0.0.1:5500/client/pages/reset-password.html

# Comma-separated frontend origins allowed to call this API.
# Example: https://catmatch.example.com,https://catmatch-e6d85.web.app
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
